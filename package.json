    "npm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamesiteonline/faliz-games-downloader-cli"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.3",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "figlet": "^1.8.0",
    "ora": "^8.2.0"
  }
}
