{
  "name": "faliz-games-downloader-cli",
  "version": "0.1.1",
  "description": "A polished terminal game catalog and authorized file downloader.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "faliz-games": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
